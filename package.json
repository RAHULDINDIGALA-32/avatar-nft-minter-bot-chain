{
  "name": "chainfolk-avatar-nft-minter",
  "version": "1.0.0",
  "description": "A DApp on Bot Chain with Next.js, Wagmi, RainbowKit, and Pinata to Mint NFTs on IPFS",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile && node scripts/exportArtifact.mjs",
    "upload": "node scripts/uploadToPinata.mjs",
    "deploy:testnet": "tsx scripts/deployChainfolkAvatarNft.ts botTestnet",
    "deploy:mainnet": "tsx scripts/deployChainfolkAvatarNft.ts botMainnet",
    "verify:mainnet": "hardhat run scripts/verifyChainfolkAvatarNft.cjs --network bot-chain",
    "verify:testnet": "hardhat run scripts/verifyChainfolkAvatarNft.cjs --network bot-chain-testnet",
    "test": "hardhat test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAHULDINDIGALA-32/avatar-nft-minter-bot-chain.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RAHULDINDIGALA-32/avatar-nft-minter-bot-chain/issues"
  },
  "homepage": "https://github.com/RAHULDINDIGALA-32/avatar-nft-minter-bot-chain#readme",
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "react-hot-toast": "^2.6.0",
    "viem": "^2.42.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/node": "^25.0.2",
    "hardhat": "^2.22.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "types": "module"
}
